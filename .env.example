# ============================================================
# Smart Traffic AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_NAME="Smart Traffic AI"
APP_ENV=production            # development | staging | production
APP_DEBUG=false
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./traffic.db
DATABASE_ECHO=false           # Set true to log SQL statements (dev only)

# --- Model Configuration ---
YOLO_MODEL_PATH=models/yolov8n.pt
YOLO_MODEL_SIZE=n             # n | s | m | l | x
HELMET_MODEL_PATH=models/helmet_v3.pt

# --- Inference Settings ---
CONFIDENCE_THRESHOLD=0.45     # Minimum detection confidence [0.0, 1.0]
HELMET_CONFIDENCE_THRESHOLD=0.35 # Helmet detection confidence threshold
IOU_THRESHOLD=0.45            # NMS IoU threshold [0.0, 1.0]
INFERENCE_FPS=10              # Target frames per second for inference
FRAME_SKIP=2                  # Process every Nth frame (1 = no skip)
DEVICE=cpu                    # cpu | cuda | mps

# --- Evidence Storage ---
EVIDENCE_DIR=evidence         # Directory for violation evidence images and video
EVIDENCE_COOLDOWN_SECONDS=3.0 # Minimum seconds between evidence saves per vehicle

# --- CORS ---
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# --- File Upload Limits ---
MAX_UPLOAD_SIZE_MB=500
